# Логин и пароль веб-интерфейса
CERTMGR_USER=admin
CERTMGR_PASSWORD=change-me

# Порт и адрес прослушивания на хосте
CERTMGR_PORT=8090
CERTMGR_BIND=0.0.0.0

# За сколько дней до истечения начинать плановое продление
RENEW_DAYS=30

# Время ежедневного запуска cron (минуты часы)
CERTMGR_CRON_TIME=17 3

# SMTP для уведомлений (начальные значения; далее можно менять в интерфейсе)
SMTP_ENABLED=true
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=user@mail.ru
SMTP_PASSWORD=change-me
SMTP_SENDER=user@mail.ru
SMTP_USE_SSL=true
SMTP_NOTIFY_TO=
SMTP_PUBLIC_URL=http://server:8090
